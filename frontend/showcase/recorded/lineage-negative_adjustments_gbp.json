imezone (TIMESTAMP_NTZ); no UTC offset is inferred.","Original workbook coordinates retained; cross-sheet repeated payloads need client reconciliation before treating rows as unique real-world purchases."]},"sql":"-- Grain: one immutable source workbook/sheet/row. Deliveries deduplicate upstream.\nWITH parsed AS (\n SELECT *,\n   trim(invoice) AS invoice_clean,\n   upper(trim(stock_code)) AS stock_code_clean,\n   try_cast(quantity AS DECIMAL(18,4)) AS quantity_decimal,\n   try_cast(unit_price AS DECIMAL(18,4)) AS price_decimal,\n   try_cast(event_time AS TIMESTAMP_NTZ) AS timestamp_parsed,\n   cast(round(try_cast(quantity AS DECIMAL(18,4)) * try_cast(unit_price AS DECIMAL(18,4)), 2) AS DECIMAL(20,2)) AS parsed_amount\n FROM source_lines\n), classified AS (\n SELECT *, CASE\n   WHEN invoice_clean IS NULL OR invoice_clean = '' THEN 'missing_invoice'\n   WHEN stock_code_clean IS NULL OR stock_code_clean = '' THEN 'missing_stock_code'\n   WHEN timestamp_parsed IS NULL THEN 'invalid_timestamp'\n   WHEN quantity_decimal IS NULL OR quantity_decimal != floor(quantity_decimal) OR quantity_decimal = 0\n     OR try_cast(quantity AS DECIMAL(28,10)) != quantity_decimal THEN 'invalid_quantity'\n   WHEN price_decimal IS NULL OR price_decimal < 0 THEN 'invalid_price'\n   WHEN try_cast(unit_price AS DECIMAL(28,10)) != price_decimal THEN 'price_precision_exceeded'\n   WHEN parsed_amount IS NULL THEN 'amount_overflow'\n   WHEN upper(invoice_clean) LIKE 'C%' AND quantity_decimal > 0 THEN 'cancellation_sign_conflict'\n   WHEN stock_code_clean IN ('POST','DOT','M','M2','C2','D','B','ADJUST','ADJUST2','BANK CHARGES','AMAZONFEE','CRUK','TEST001','TEST002') THEN 'non_merchandise_code'\n   WHEN quantity_decimal < 0 THEN 'negative_adjustment'\n   ELSE 'positive_merchandise'\n END AS classification\n FROM parsed\n)\nSELECT line_id, invoice_clean AS invoice, stock_code_clean AS stock_code, description,\n cast(quantity_decimal AS BIGINT) AS quantity, price_decimal AS unit_price,\n parsed_amount AS line_amount, timestamp_parsed AS event_time,\n cast(timestamp_parsed AS DATE) AS date,\n nullif(trim(customer_id), '') AS customer_id,\n coalesce(nullif(trim(country), ''), 'Unknown') AS country,\n source_sha256, source_sheet, source_row, ingested_at, conversion_version,\n classification,\n CASE WHEN classification IN ('positive_merchandise','negative_adjustment') THEN 'accepted'\n      WHEN classification = 'non_merchandise_code' THEN 'excluded'\n      ELSE 'quarantined' END AS disposition,\n parsed_amount\nFROM classified\n\n\n-- Grain: observed source date, no zero filling of unavailable dates.\nSELECT date,\n cast(sum(CASE WHEN line_amount > 0 THEN line_amount ELSE 0 END) AS DECIMAL(22,2)) AS gross_positive_gbp,\n cast(sum(CASE WHEN line_amount < 0 THEN line_amount ELSE 0 END) AS DECIMAL(22,2)) AS negative_adjustments_gbp,\n cast(sum(line_amount) AS DECIMAL(22,2)) AS net_recorded_gbp,\n sum(CASE WHEN quantity > 0 THEN quantity ELSE 0 END) AS positive_units,\n count(*) AS rows,\n sum(CASE WHEN customer_id IS NOT NULL THEN 1 ELSE 0 END) AS known_customer_rows\nFROM fact_invoice_line GROUP BY date\n","rows":[{"line_id":"9ca46ab18d6b65f3a61f199336cb05a3a53d549443b5d7e5db9d4600c7b58fde","invoice":"C489449","stock_code":"22087","description":"PAPER BUNTING WHITE LACE","quantity":-12,"unit_price":2.95,"line_amount":-35.4,"event_time":"2009-12-01T10:33:00","date":"2009-12-01","customer_id":"16321","country":"Australia","source_sha256":"bcbe73b35f5b7babf197fb0cb983a11f5d9ff929078d4aa53d171b1f2df2e980","source_sheet":"Year 2009-2010","source_row":180,"ingested_at":"2026-11-16T19:09:04.189541+00:00","conversion_version":"xlsx-stream-v1","classification":"negative_adjustment","disposition":"accepted","parsed_amount":-35.4},{"line_id":"2811c3ffcf32b72542f0841fcff4921cd266e7eaaa339b92eda075831f2ef1fb","invoice":"C489449","stock_code":"85206A","description":"CREAM FELT EASTER EGG BASKET","quantity":-6,"unit_price":1.65,"line_amount":-9.9,"event_time":"2009-12-01T10:33:00","